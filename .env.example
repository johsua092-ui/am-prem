# ============================================
# AM Premium Generator - Environment Variables
# ============================================

# --- API Backend ---
# Base URL of the backend API (the actual pakeaja.online backend or your own proxy)
API_BASE_URL=https://www.pakeaja.online

# API key if required by the backend
API_KEY=

# --- Alight Motion API Endpoints ---
# These are the relative paths used to proxy requests
# Step 1: Send magic link to email
AM_SEND_MAGIC_LINK_PATH=/api/tools/am-premium

# --- App Config ---
NEXT_PUBLIC_SITE_NAME=AM Premium Generator
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Jadikan akun Alight Motion Anda premium selama 1 tahun secara gratis. Tanpa kata sandi dan dijamin aman 100%.
